{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/check-env.sh)",
      "Bash(bash scripts/pull-roster.sh:*)",
      "Bash(uv run scripts/render-roster.py:*)",
      "Bash(uv run scripts/bench.py:*)",
      "Bash(ollama list)",
      "Bash(ollama ps)",
      "Bash(ollama show:*)",
      "Bash(ollama --version)",
      "Bash(shellcheck:*)",
      "Bash(bash -n:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(nproc)",
      "Bash(free -h)",
      "Bash(df -h:*)",
      "WebFetch(domain:ollama.com)",
      "WebFetch(domain:huggingface.co)",
      "WebFetch(domain:research.ibm.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:openai.com)",
      "WebFetch(domain:docs.astral.sh)"
    ],
    "ask": [
      "Bash(ollama pull:*)",
      "Bash(ollama rm:*)"
    ]
  }
}
